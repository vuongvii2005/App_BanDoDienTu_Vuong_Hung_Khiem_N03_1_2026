rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userDocExists(uid) {
      return exists(/databases/$(database)/documents/users/$(uid));
    }

    function userRole(uid) {
      return signedIn() && userDocExists(uid)
          ? (get(/databases/$(database)/documents/users/$(uid)).data.role is string
              ? get(/databases/$(database)/documents/users/$(uid)).data.role
              : 'user')
          : 'guest';
    }

    function userActive(uid) {
      return signedIn() && userDocExists(uid)
          && get(/databases/$(database)/documents/users/$(uid)).data.isActive != false;
    }

    function isCustomerRole(role) {
      return role == 'user'
        || role == 'customer'
        || role == 'client'
        || role == 'member'
        || role == 'khach_hang'
        || role == 'khach hang';
    }

    function isConfiguredAdminEmail() {
      return signedIn()
        && request.auth.token.email == 'admin@techstore.local';
    }

    function configuredAdminActive() {
      return isConfiguredAdminEmail()
        && (!userDocExists(request.auth.uid)
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isActive != false);
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isUser() {
      return signedIn()
        && userActive(request.auth.uid)
        && isCustomerRole(userRole(request.auth.uid))
        && !isConfiguredAdminEmail();
    }

    function isAdmin() {
      return signedIn()
        && (configuredAdminActive()
          || (userActive(request.auth.uid)
            && userRole(request.auth.uid) == 'admin'));
    }

    function activeProduct(productId) {
      return exists(/databases/$(database)/documents/products/$(productId))
        && get(/databases/$(database)/documents/products/$(productId)).data.isActive == true;
    }

    match /categories/{categoryId} {
      allow read: if resource.data.isActive == true || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /products/{productId} {
      allow read: if resource.data.isActive == true || isAdmin();
      allow create, update, delete: if isAdmin();

      match /variants/{variantId} {
        allow read: if isAdmin()
          || (activeProduct(productId) && resource.data.isActive == true);
        allow create, update, delete: if isAdmin();
      }
    }

    match /users/{uid} {
      allow create: if isAdmin()
        || (isOwner(uid)
          && request.resource.data.uid == uid
          && request.resource.data.id == uid
          && request.resource.data.isActive == true
          && request.resource.data.keys().hasOnly([
            'uid',
            'id',
            'fullName',
            'email',
            'phone',
            'avatarUrl',
            'address',
            'role',
            'isActive',
            'createdAt',
            'updatedAt'
          ])
          && (request.resource.data.role == 'user'
            || (isConfiguredAdminEmail()
              && request.resource.data.role == 'admin')));
      allow read: if isOwner(uid) || isAdmin();
      allow update: if isAdmin()
        || (isOwner(uid)
          && isUser()
          && request.resource.data.uid == uid
          && request.resource.data.id == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'fullName',
            'phone',
            'avatarUrl',
            'address',
            'email',
            'uid',
            'id',
            'role',
            'isActive',
            'updatedAt'
          ])
          && (!(resource.data.uid is string) || resource.data.uid == uid)
          && (request.resource.data.role == resource.data.role
            || request.resource.data.role == 'user'
            || (!(resource.data.role is string)
              && request.resource.data.role == 'user'))
          && (request.resource.data.isActive == resource.data.isActive
            || (!(resource.data.isActive is bool)
              && request.resource.data.isActive == true)));
      allow delete: if isAdmin();

      match /addresses/{addressId} {
        allow read: if isAdmin() || (isOwner(uid) && isUser());
        allow create, update: if isAdmin()
          || (isOwner(uid)
            && isUser()
            && request.resource.data.receiverName is string
            && request.resource.data.phone is string
            && request.resource.data.city is string
            && request.resource.data.district is string
            && request.resource.data.detail is string
            && request.resource.data.isDefault is bool);
        allow delete: if isAdmin() || (isOwner(uid) && isUser());
      }

      match /favorites/{productId} {
        allow read: if isAdmin() || (isOwner(uid) && isUser());
        allow create, update: if isAdmin()
          || (isOwner(uid)
            && isUser()
            && request.resource.data.productId == productId);
        allow delete: if isAdmin() || (isOwner(uid) && isUser());
      }
    }

    match /carts/{uid} {
      allow read, write: if isOwner(uid) && isUser();

      match /items/{itemId} {
        allow read, write: if isOwner(uid) && isUser();
      }
    }

    match /orders/{orderId} {
      allow create: if isAdmin()
        || (isUser()
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.status == 'pending'
          && request.resource.data.items is list
          && request.resource.data.total is number);
      allow read: if isAdmin()
        || (isUser() && resource.data.userId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    match /coupons/{couponId} {
      allow read: if resource.data.isActive == true || isAdmin();
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (isUser()
          && resource.data.isActive == true
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['usedCount', 'updatedAt'])
          && request.resource.data.usedCount == resource.data.usedCount + 1);
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isUser()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.productId is string
        && request.resource.data.rating is number
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.comment is string
        && request.resource.data.comment.size() > 0
        && request.resource.data.comment.size() <= 500
        && request.resource.data.images is list;
      allow update: if isAdmin()
        || (isUser()
          && resource.data.userId == request.auth.uid
          && request.resource.data.userId == resource.data.userId
          && request.resource.data.productId == resource.data.productId
          && request.resource.data.rating is number
          && request.resource.data.rating >= 1
          && request.resource.data.rating <= 5
          && request.resource.data.comment is string
          && request.resource.data.comment.size() > 0
          && request.resource.data.comment.size() <= 500
          && request.resource.data.images is list);
      allow delete: if isAdmin()
        || (isUser() && resource.data.userId == request.auth.uid);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
